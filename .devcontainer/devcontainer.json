{
  "name": "RobustDistill Streamlit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "RobustDistill Streamlit", "onAutoForward": "openBrowser" }
  }
}
